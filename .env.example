# ============================================================
# Autonomous Yandex Dzen Publishing Platform
# .env.example — скопировать в .env и заполнить
# ============================================================

# Publisher Service
PUBLISHER_PORT=8001
PUBLISHER_API_KEY=your_random_secret_here_generate_with_python

# Дзен
DZEN_COOKIES_PATH=./cookies/dzen_cookies.json
DZEN_CHANNEL_URL=https://dzen.ru/id/YOUR_CHANNEL_ID

# Прокси (мобильные резидентные)
PROXY_URL=http://user:password@proxy.host:port

# Лимиты (используются как fallback если DATABASE_URL не задан)
MAX_DAILY_PUBLICATIONS=3
ACTION_DELAY_MIN=1.5
ACTION_DELAY_MAX=4.0

# PostgreSQL (Supabase) — прямое подключение из Publisher Service
# Используется для хранения today_count/daily_limit в dzen.accounts
# Найти в Supabase: Project Settings → Database → Connection string (Transaction pooler)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# AI API
ANTHROPIC_API_KEY=sk-ant-
OPENAI_API_KEY=sk-
PERPLEXITY_API_KEY=pplx-

# Supabase
SUPABASE_URL=https://sb.kalininlive.ru
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# n8n
N8N_BASE_URL=https://n8n.kalininlive.ru
N8N_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
