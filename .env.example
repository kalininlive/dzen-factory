# ============================================================
# Autonomous Yandex Dzen Publishing Platform
# .env.example — скопировать в .env и заполнить
# ============================================================

# Publisher Service
PUBLISHER_PORT=8001
PUBLISHER_API_KEY=your_random_secret_here_generate_with_python

# Дзен
DZEN_COOKIES_PATH=./cookies/dzen_cookies.json
DZEN_CHANNEL_URL=

# Прокси (мобильные резидентные)
# PROXY_URL=

# Лимиты (используются как fallback если DATABASE_URL не задан)
MAX_DAILY_PUBLICATIONS=3
ACTION_DELAY_MIN=1.5
ACTION_DELAY_MAX=4.0

# PostgreSQL (Supabase) — прямое подключение из Publisher Service
# Используется для хранения today_count/daily_limit в dzen.accounts
# Найти в Supabase: Project Settings → Database → Connection string (Transaction pooler)
DATABASE_URL=

# AI API
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# n8n
N8N_BASE_URL=
N8N_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
